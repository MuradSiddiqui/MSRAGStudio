# Copy to .env and fill in. Never commit .env
MSRAG_GROQ_API_KEY=
MSRAG_QDRANT_URL=
MSRAG_QDRANT_API_KEY=
MSRAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Vision: Groq's catalogue for this account has no vision model, so image
# descriptions use Google Gemini (free key from Google AI Studio).
# MSRAG_VISION_PROVIDER=auto uses Gemini when its key is set, else Groq.
MSRAG_GEMINI_API_KEY=
MSRAG_VISION_PROVIDER=auto
# Optional: primary Gemini vision model (default gemini-3.8-flash).
# gemini-2.5-flash is closed to new users; the backend falls back to
# other Flash models automatically if the primary is unavailable.
# MSRAG_GEMINI_VISION_MODEL=gemini-3.8-flash
# Soft flag only (not a retrieval cutoff). Top hit below this → evidence: "low".
# MSRAG_LOW_EVIDENCE_THRESHOLD=0.68
